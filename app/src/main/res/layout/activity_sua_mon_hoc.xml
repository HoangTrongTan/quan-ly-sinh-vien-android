<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Sua_MonHoc">
    <TextView
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="35sp"
        android:background="#34F10A"
        android:text="Sửa Môn Học"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"></TextView>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:weightSum="10"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:gravity="center"
        android:layout_height="wrap_content">
        <TextView
            android:text="Mã Môn Học"
            android:layout_width="wrap_content"
            android:layout_weight="0.5"
            android:textSize="18sp"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/edt_s_MaMon"
            android:enabled="false"
            android:layout_weight="9.5"
            android:hint="Mã Môn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:weightSum="10"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="10dp"
        android:gravity="center"
        android:layout_height="wrap_content">
        <TextView
            android:text="Tên Môn Học"
            android:layout_width="wrap_content"
            android:layout_weight="0.35"
            android:textSize="18sp"
            android:layout_height="wrap_content"/>
        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="9.65"
            android:hint="Môn Học"
            android:id="@+id/edt_s_MonHoc" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:weightSum="10"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="10dp"
        android:gravity="center"
        android:layout_height="wrap_content">
        <TextView
            android:text="Số Tiết"
            android:layout_width="wrap_content"
            android:layout_weight="2.1"
            android:textSize="18sp"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edt_s_SoTiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="7.9"
            android:hint="Số Tiết" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btnLuu"
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:text="Lưu" />

        <Button
            android:layout_marginLeft="50dp"
            android:id="@+id/btnHuy"
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:text="Hủy" />
    </LinearLayout>
</LinearLayout>