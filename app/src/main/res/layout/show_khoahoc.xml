<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:layout_margin="10dp"
    android:layout_marginBottom="15dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã Khoa"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Khoa"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Niên Khóa"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="8dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : " />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : " />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : " />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtMaKhoa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã Khoa" />
            <TextView
                android:id="@+id/txtTenKhoa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Khoa" />
            <TextView
                android:id="@+id/txtNienKhoa"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Niên Khóa" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnSua"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:src="@android:drawable/ic_menu_edit"></ImageView>

        <ImageView
            android:id="@+id/btnXoa"
            android:layout_marginTop="5dp"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:src="@android:drawable/ic_menu_delete"></ImageView>
    </LinearLayout>
</LinearLayout>